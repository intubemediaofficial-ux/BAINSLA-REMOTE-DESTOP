{
  "name": "kv-desk",
  "version": "1.0.4",
  "private": true,
  "description": "Bainsla Remote remote desktop host and viewer",
  "main": "main.js",
  "scripts": {
    "copy-shared": "node scripts/copy-shared.js",
    "prestart": "npm run copy-shared",
    "start": "electron .",
    "predist:win": "npm run copy-shared",
    "dist:win": "electron-builder --win nsis",
    "predist:mac": "npm run copy-shared",
    "dist:mac": "electron-builder --mac dmg --x64 --arm64"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "electron": "^35.1.5",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.bainsla.remote",
    "productName": "Bainsla Remote",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!build/BainslaRemoteService.exe",
      "!build/BainslaRemoteService.xml",
      "!build/WINSW-LICENSE.txt",
      "!build/installer.nsh",
      "!build/mac-adhoc-sign.js",
      "!build/icon.icns",
      "!scripts",
      "build/icon.png",
      "build/icon-active.png",
      "build/trayTemplate.png",
      "build/trayTemplate@2x.png",
      "vendor/**/*"
    ],
    "afterPack": "build/mac-adhoc-sign.js",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "executableName": "BainslaRemote",
      "extraResources": [
        {
          "from": "build/BainslaRemoteService.exe",
          "to": "BainslaRemoteService.exe"
        },
        {
          "from": "build/BainslaRemoteService.xml",
          "to": "BainslaRemoteService.xml"
        },
        {
          "from": "build/WINSW-LICENSE.txt",
          "to": "WINSW-LICENSE.txt"
        }
      ],
      "artifactName": "BainslaRemote-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true,
      "include": "build/installer.nsh",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": "dmg",
      "identity": null,
      "hardenedRuntime": false,
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "artifactName": "BainslaRemote-${version}-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "BainslaRemote-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Network"
    }
  }
}
