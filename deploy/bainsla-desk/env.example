# Copy to /opt/bainsla-desk/.env and fill in. Never commit the real file.
PORT=3500
BASE_PATH=
DATA_DIR=/opt/bainsla-desk/data
DOWNLOADS_DIR=/opt/bainsla-desk/downloads
PUBLIC_ORIGIN=https://remote.example.com
ADMIN_EMAIL=you@example.com
# Only used the first time, when the database has no admin yet
ADMIN_PASSWORD=change-me-long-password
# Long random strings: openssl rand -hex 32
SESSION_SECRET=
TURN_SECRET=
TURN_HOST=remote.example.com
# Brevo (brevo.com) transactional e-mail key, for the admin "Forgot password" OTP
BREVO_API_KEY=
MAIL_FROM=no-reply@example.com
